{
  "name": "blueprint-pbi",
  "displayName": "Blueprint for Power BI",
  "description": "Build and check Power BI PBIP report pages from YAML specs, as MCP tools for Copilot. Bundles the Blueprint engine: no Python needed.",
  "version": "0.1.0",
  "publisher": "TODO-PUBLISHER-ID",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurdasss/blueprint.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "blueprint",
        "label": "Blueprint (Power BI report layouts)"
      }
    ],
    "commands": [
      {
        "command": "blueprint.setUpOtherClients",
        "title": "Blueprint: Set Up for Other MCP Clients"
      }
    ],
    "configuration": {
      "title": "Blueprint",
      "properties": {
        "blueprint.guidelines": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the guidelines YAML file every Blueprint tool uses by default (passed to the server as `BLUEPRINT_GUIDELINES`). A tool call can still name its own `guidelines`."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "7.0.2"
  }
}
