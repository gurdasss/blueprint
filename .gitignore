# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Virtual environments ---
.venv/
venv/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Power BI project (PBIP) local-only files ---
# Per-user, per-machine report settings (Microsoft says to exclude these)
**/.pbi/localSettings.json
# Semantic model data cache
**/.pbi/cache.abf

# --- Scratch ---
/tmp/

# --- Real reports used for format study (see samples/README.md) ---
/samples/*
!/samples/README.md

# Binary Power BI files never belong in the repo
*.pbix
*.pbit

# --- Tenant guidelines are private; only the invented example and layouts are public ---
/guidelines/*
!/guidelines/example.yaml
!/guidelines/layouts/

# --- Claude Code per-user settings ---
.claude/settings.local.json
